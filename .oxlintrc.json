{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "import"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error",
    "import/named": "error"
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**",
        "test/**"
      ],
      "env": {
        "browser": true,
        "es2024": true,
        "node": true
      }
    }
  ],
  "globals": {
    "__BUILD_ID__": "readonly"
  }
}
