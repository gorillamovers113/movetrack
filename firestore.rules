rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() && me().status == 'active';
    }
    function hasRole(r) {
      return isActive() && me().role == r;
    }
    function isAdmin() {
      return hasRole('admin');
    }
    // packer/mover/driver/warehouse may write units/containers/overflow/events,
    // scoped to the specific stage transition their role owns (see the
    // transition helpers below). Admin is exempt from all of these checks.
    function isCrew() {
      return isActive() && me().role in ['packer', 'mover', 'driver', 'warehouse'];
    }

    // meta/project.returnPhase gate for the return leg (see the return
    // transition helpers below). Only ever evaluated on the right-hand side
    // of a short-circuited `||`, after the outbound check has already come
    // back false, so this get() is never spent on an outbound write.
    function returnPhaseOn() {
      return get(/databases/$(database)/documents/meta/project).data.returnPhase == true;
    }

    // ---- stage-transition helpers ----
    // Each one encodes the exact (role, before -> after) pairs a non-admin
    // may perform, taken line-by-line from the dispatch() switch in
    // src/store.jsx. A doc that has moved past a role's stage no longer
    // matches any pair for that role, so it locks to that role once the
    // stage advances. Outbound pairs are always allowed; return-leg pairs
    // (docs/superpowers/specs/2026-08-26-return-phase-design.md §6) are the
    // exact reverse and only fire when returnPhase is on.

    // units: not_started -> packing -> packed -> loaded -> picked_up -> at_warehouse
    //   -> return_loaded -> return_transit -> back_on_site -> unloaded -> unpacked
    //
    // ENTRY vs CONTINUATION (docs/superpowers/specs/2026-08-27-return-leg-correctness-fixes.md #2):
    // only the transition FROM at_warehouse INTO the return leg
    // (at_warehouse -> return_loaded, loadForReturn) requires returnPhaseOn().
    // Every later return hop is a continuation of a round trip already in
    // progress and is allowed regardless of returnPhase (still role+stage
    // gated), so toggling the phase off never strands a unit mid-return.
    function unitTransitionOK(role, before, after) {
      return (role == 'packer'
              && ((before == 'not_started' && after == 'packing')   // startPacking
                  || (before == 'packing' && after == 'packed')))   // finishPacking
          || (role == 'mover'
              && ((before == 'packed' && after == 'loaded')         // loadUnit
                  || (before == 'loaded' && after == 'picked_up'))) // bigboxSwap (units in a full container)
          || (role == 'warehouse'
              && before == 'picked_up' && after == 'at_warehouse')  // warehouseReceive
          || unitReturnTransitionOK(role, before, after);
    }
    function unitReturnTransitionOK(role, before, after) {
      return (role == 'warehouse'
              && ((before == 'at_warehouse' && after == 'return_loaded' && returnPhaseOn())  // loadForReturn (entry)
                  || (before == 'return_loaded' && after == 'return_transit')))               // dispatchReturn (its units)
          || (role == 'mover'
              && ((before == 'return_transit' && after == 'back_on_site')    // deliverReturn (its units)
                  || (before == 'back_on_site' && after == 'unloaded')))     // unloadReturn
          || (role == 'packer'
              && before == 'unloaded' && after == 'unpacked');               // unpackUnit, terminal
    }

    // containers: empty -> filling -> full -> picked_up -> at_warehouse
    //   -> return_filling -> return_full -> return_transit -> back_on_site -> returned_empty
    // Note: loading a unit sets status to 'filling' whether the container was
    // empty or already filling (a second load is filling -> filling, no
    // status change) — both must be allowed for the mover. Same story on the
    // return leg for return_filling -> return_filling.
    // Same entry-vs-continuation split as unitTransitionOK above: only the
    // at_warehouse -> return_filling entry hop (loadForReturn's first unit
    // into this container) requires returnPhaseOn(). The return_filling ->
    // return_filling self-loop (a second/third loadForReturn onto a
    // container already on the return leg) and every later return hop are
    // continuations, allowed regardless of returnPhase.
    function containerTransitionOK(role, before, after) {
      return (role == 'mover'
              && (((before == 'empty' || before == 'filling') && after == 'filling') // loadUnit
                  || (before == 'filling' && after == 'full')                        // markContainerFull
                  || (before == 'full' && after == 'picked_up')))                    // bigboxSwap
          || (role == 'warehouse'
              && before == 'picked_up' && after == 'at_warehouse')                   // warehouseReceive
          || containerReturnTransitionOK(role, before, after);
    }
    function containerReturnTransitionOK(role, before, after) {
      return (role == 'warehouse'
              && ((before == 'at_warehouse' && after == 'return_filling' && returnPhaseOn()) // loadForReturn (entry)
                  || (before == 'return_filling' && after == 'return_filling')       // loadForReturn (2nd+ unit, continuation)
                  || (before == 'return_filling' && after == 'return_full')          // markReturnFull
                  || (before == 'return_full' && after == 'return_transit')))        // dispatchReturn
          || (role == 'mover'
              && ((before == 'return_transit' && after == 'back_on_site')            // deliverReturn
                  || (before == 'back_on_site' && after == 'returned_empty')));      // unloadReturn (last unit out)
    }

    // overflow: identified -> prepped -> in_transit -> at_warehouse
    //   -> rt_transit -> returned
    // (packers only *create* overflow, they never update it, except on the
    // return leg where returnOverflow may be done by a mover or a packer.)
    // Same entry-vs-continuation split: only the at_warehouse -> rt_transit
    // entry hop (transportOverflowBack) requires returnPhaseOn(). rt_transit
    // -> returned (returnOverflow) is a continuation, allowed regardless.
    function overflowTransitionOK(role, before, after) {
      return (role == 'mover'
              && ((before == 'identified' && after == 'prepped')      // prepOverflow
                  || (before == 'prepped' && after == 'in_transit'))) // transportOverflow
          || (role == 'warehouse'
              && before == 'in_transit' && after == 'at_warehouse')   // receiveOverflow
          || overflowReturnTransitionOK(role, before, after);
    }
    function overflowReturnTransitionOK(role, before, after) {
      return (role == 'mover'
              && ((before == 'at_warehouse' && after == 'rt_transit' && returnPhaseOn())  // transportOverflowBack (entry)
                  || (before == 'rt_transit' && after == 'returned')))                     // returnOverflow
          || (role == 'packer'
              && before == 'rt_transit' && after == 'returned');       // returnOverflow
    }

    // ---- container self-loop field lock (non-admin update only) ----
    // The filling->filling / return_filling->return_filling self-loop above
    // exists only so a second loadUnit/loadForReturn onto an already-filling
    // container isn't rejected as a no-op transition. Left unchecked, that
    // same no-op status opens the door to a direct write that holds status
    // steady while tampering with media/driverName/bay/flag/etc, with no
    // event trail. Lock it down: on a same-status write, only the fields the
    // real dispatch touches (status, unitIds) may change. Non-self-loop
    // writes (any real stage advance) always pass this check.
    function containerSelfLoopOK(before, after) {
      return before != after
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'unitIds']);
    }

    // ---- custody attribution guard (non-admin update only) ----
    // receivedBy/handoffBy/prepBy/transportBy/returnedBy, and their
    // RETURN-prefixed counterparts returnReceivedBy/returnHandoffBy/
    // returnTransportBy, each record who physically handled a custody
    // handoff (warehouseReceive/deliverReturn, bigboxSwap/dispatchReturn,
    // prepOverflow, transportOverflow/transportOverflowBack, returnOverflow).
    // The return-prefixed fields exist so a return-leg handoff (dispatchReturn/
    // deliverReturn/transportOverflowBack) records its own custody witness
    // instead of overwriting the outbound field already on the same doc
    // (docs/superpowers/specs/2026-08-27-return-leg-correctness-fixes.md #3);
    // they need the exact same uid-pin as the originals so they can't be
    // forged either. Every real dispatch sets these to currentUser.uid; a
    // non-admin write may only set/change one of them to its own uid,
    // mirroring the events.uid guard below so custody can't be misattributed
    // to someone else.
    //
    // request.resource.data is the full post-write document, so a field
    // stamped by an earlier stage (e.g. handoffBy from bigboxSwap) is still
    // present, unchanged, on a later write by a different actor (e.g.
    // warehouseReceive's receivedBy). Only flag the field when THIS write is
    // the one setting/changing it (its value differs from resource.data,
    // the pre-write doc). A carried-over value from a prior legitimate
    // handoff is left alone.
    function custodyFieldOK(field) {
      return !(field in request.resource.data)
          || request.resource.data[field] == resource.data.get(field, null)
          || request.resource.data[field] == request.auth.uid;
    }
    function custodyFieldsOK() {
      return custodyFieldOK('receivedBy')
          && custodyFieldOK('handoffBy')
          && custodyFieldOK('prepBy')
          && custodyFieldOK('transportBy')
          && custodyFieldOK('returnedBy')
          && custodyFieldOK('returnReceivedBy')
          && custodyFieldOK('returnHandoffBy')
          && custodyFieldOK('returnTransportBy');
    }

    // ---- identity-field guards (non-admin update only) ----
    // "modify only your own current part" — a stage-advancing write may not
    // also rename/re-floor/re-number the doc it's advancing.
    function unitIdentityUnchanged() {
      return request.resource.data.number == resource.data.number
          && request.resource.data.tenant == resource.data.tenant
          && request.resource.data.floor == resource.data.floor
          && request.resource.data.createdAt == resource.data.createdAt;
    }
    function containerIdentityUnchanged() {
      return request.resource.data.number == resource.data.number
          && request.resource.data.deliveredAt == resource.data.deliveredAt;
    }
    function overflowIdentityUnchanged() {
      return request.resource.data.unitId == resource.data.unitId
          && request.resource.data.unitNumber == resource.data.unitNumber
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---- users ----
    // Signup: a user may create only their own doc, and only in the pending,
    // roleless state. Admin approval (setting role + status='active') happens
    // via a separate update, which only admins may perform.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == null;

      allow update, delete: if isAdmin();
    }

    // ---- operational collections ----
    match /units/{unitId} {
      allow read: if isActive();

      // createUnit: admin, or packer starting a fresh unit at not_started.
      allow create: if (isAdmin() || hasRole('packer'))
        && request.resource.data.stage == 'not_started';

      // admin may edit/fix/adjust anything; a crew member may only advance
      // the doc through the one transition their role owns, and may not
      // touch the unit's identity fields while doing so.
      allow update: if isAdmin()
        || (isCrew()
            && unitTransitionOK(me().role, resource.data.stage, request.resource.data.stage)
            && unitIdentityUnchanged()
            && custodyFieldsOK());

      allow delete: if isAdmin();
    }

    match /containers/{containerId} {
      allow read: if isActive();

      // logEmpties / bigboxSwap new-empties: admin, or mover dropping a
      // fresh empty container.
      allow create: if (isAdmin() || hasRole('mover'))
        && request.resource.data.status == 'empty'
        && request.resource.data.unitIds == [];

      allow update: if isAdmin()
        || (isCrew()
            && containerTransitionOK(me().role, resource.data.status, request.resource.data.status)
            && containerIdentityUnchanged()
            && containerSelfLoopOK(resource.data.status, request.resource.data.status)
            && custodyFieldsOK());

      allow delete: if isAdmin();
    }

    // Overflow items (Gorilla-transported, too big for a BigBox container):
    // packer identifies (create only), mover preps & transports, warehouse
    // receives; admin can always edit/fix/adjust.
    match /overflow/{overflowId} {
      allow read: if isActive();

      // createOverflow: admin, packer, or mover, always starting at
      // identified, and createdBy must be the caller (mirrors events.uid
      // below) so custody of a freshly identified item can't be forged onto
      // someone else from the very first write.
      allow create: if (isAdmin() || hasRole('packer') || hasRole('mover'))
        && request.resource.data.stage == 'identified'
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        || (isCrew()
            && overflowTransitionOK(me().role, resource.data.stage, request.resource.data.stage)
            && overflowIdentityUnchanged()
            && custodyFieldsOK());

      allow delete: if isAdmin();
    }

    // Append-only accountability log: any active crew member (or admin) may
    // log an event, but only as themselves — never forging another user's
    // action. Once written, an event may not be edited or removed except by
    // an admin.
    match /events/{eventId} {
      allow read: if isActive();
      allow create: if (isAdmin() || isCrew())
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /schedule/{scheduleId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Project-level singleton: the return-phase switch (setReturnPhase) plus
    // name/address. Any active user may read it (the board needs to know
    // whether the return leg is on); only an admin may flip it.
    match /meta/project {
      allow read: if isActive();
      allow write: if isAdmin();
    }
  }
}
