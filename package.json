{
  "name": "movetrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run test/rules\"",
    "prebuild": "oxlint src",
    "test:actions": "firebase emulators:exec --only firestore \"vitest run test/actions\"",
    "postbuild": "node scripts/check-version.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^14.3.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^3.0.0"
  }
}
