rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {

    // WHY THERE IS NO isActive() CHECK HERE
    //
    // These rules used to gate every read and write on an isActive() helper
    // that called firestore.get() on users/{uid}. Cloud Storage rules cannot
    // read Firestore. Firebase's own documentation is explicit: "In Realtime
    // Database and Cloud Storage, your rules can't use the get() method that
    // Cloud Firestore rules can incorporate."
    //
    // So that call always failed, every rule evaluated false, and EVERY
    // Storage read and write on this project had been denied since the rules
    // were written, admin included. Verified against production: reading a
    // non-existent object returned 403 rather than the 404 it would return if
    // the rule had passed. No IAM grant fixes this; it is not a permissions
    // gap, the function does not exist in this rules language.
    //
    // It stayed invisible because captureMedia() (src/lib/upload.js) catches a
    // failed upload and embeds the photo in the Firestore document as a base64
    // data URL instead. Photos appeared to work while quietly filling a
    // document that has a hard 1 MiB ceiling: unit 906 reached 866 KB on four
    // photos, and the fifth would have been rejected outright.
    //
    // What Storage rules CAN see is request.auth and the object path, so that
    // is what these use. The trade against the original intent: any
    // signed-in account can read files and upload under its own uid, rather
    // than only crew an admin has approved. Someone would have to sign up
    // deliberately to reach it, they cannot get past the app's own gate to do
    // anything else, uploads stay capped at 15 MB and image/video only, and
    // every object still carries its uploader's uid so nothing is anonymous.
    //
    // To genuinely restore "approved crew only", the status has to live
    // somewhere Storage rules can see it: a custom claim on the Auth token,
    // set by the Admin SDK when an admin approves someone. That needs a Cloud
    // Function, which needs the project on Blaze. Worth doing after the move.

    function isSignedIn() {
      return request.auth != null;
    }

    function withinSizeAndType() {
      return request.resource.size < 15 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*');
    }

    // The uploader's own uid is always baked into the filename by
    // filesToMedia() and captureMedia() (src/store.jsx, src/lib/upload.js).
    // A multi-segment wildcard (`{x=**}`) is a path object, not a string, so
    // this checks `request.resource.name`, the full object path, which is
    // already a string. Requiring it means a direct write cannot plant a file
    // that claims to have come from a different user.
    function pathHasOwnUid() {
      return request.resource.name.matches('.*' + request.auth.uid + '.*');
    }

    match /{allPaths=**} {
      allow read: if isSignedIn();
    }

    // Writes stay scoped to the three prefixes the app actually uses, so a
    // devtools write cannot land under an arbitrary path.
    //
    // Note that `write` covers delete too, and a delete carries no
    // request.resource, so pathHasOwnUid() fails and crew CANNOT delete
    // files. That is deliberate and worth keeping: these photos are the
    // evidence a damage claim turns on weeks later, so they should be
    // append-only to everyone on site. Removing one is a console job.
    match /containers/{allPaths=**} {
      allow write: if isSignedIn() && withinSizeAndType() && pathHasOwnUid();
    }
    match /overflow/{allPaths=**} {
      allow write: if isSignedIn() && withinSizeAndType() && pathHasOwnUid();
    }
    match /units/{allPaths=**} {
      allow write: if isSignedIn() && withinSizeAndType() && pathHasOwnUid();
    }
  }
}
