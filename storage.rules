rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() && me().status == 'active';
    }

    // NOTE: Storage isn't provisioned yet (Phase 2). These rules are written
    // ahead of time but are not deployed until a bucket exists.
    match /{allPaths=**} {
      allow read: if isActive();
      allow write: if isActive()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
