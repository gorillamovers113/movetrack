rules_version = "2";
service firebase.storage {
  match /b/{bucket}/o {

    // KNOWN BROKEN, 2026-09-07: every read and write below is currently
    // DENIED, including for the admin. isActive() does a firestore.get(),
    // which is a cross-service rule, and that only works once the Firebase
    // Storage service agent has been granted read access to Firestore. That
    // grant was never made on this project, so firestore.get() fails and
    // every rule here evaluates false.
    //
    // It went unnoticed because captureMedia() (src/lib/upload.js) catches an
    // upload failure and embeds the photo in the Firestore document as a
    // base64 data URL instead. Photos kept appearing to work while quietly
    // filling a document that has a hard 1 MiB ceiling: unit 906 reached
    // 866 KB on four photos, and the fifth would have been rejected.
    //
    // THE FIX (Google Cloud Console, a couple of minutes):
    //   IAM & Admin -> Grant access
    //   Principal: service-167045504697@gcp-sa-firebasestorage.iam.gserviceaccount.com
    //   Role:      Cloud Datastore Viewer
    // Then re-test an upload. Nothing in this file needs to change.
    //
    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return isSignedIn() && me().status == 'active';
    }

    function withinSizeAndType() {
      return request.resource.size < 15 * 1024 * 1024
          && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Every real upload goes through uploadImage() (src/lib/upload.js),
    // called only with paths like `containers/{id}/receive/{ts}-{uid}.jpg`,
    // `containers/swaps/{ts}-{uid}.jpg`, `overflow/{id}/prep/{ts}-{uid}.jpg`,
    // `units/{id}/inventory/{ts}-{uid}.jpg` (see the call sites in
    // src/components/*.jsx, src/views/*.jsx). The uploader's own uid is
    // always baked into the filename, right before the extension. A
    // multi-segment wildcard (`{x=**}`) is a path object, not a string, so
    // this checks `request.resource.name` (the full object path, already a
    // string) instead of trying to isolate the last segment; requiring it
    // here means a direct write can't plant a file that claims to have come
    // from a different user.
    function pathHasOwnUid() {
      return request.resource.name.matches('.*' + request.auth.uid + '.*');
    }

    // NOTE: Storage is live (deployed, not a Phase-2 placeholder). Reads stay
    // open to any active user across all paths (crew need to see each
    // other's photos regardless of who's assigned where); writes are scoped
    // below to the app's three known top-level prefixes plus an own-uid
    // filename check, so a devtools write can't land under an arbitrary path
    // or masquerade as another user's upload.
    //
    // Follow-up (not done here): fully role-scoping writes (e.g. excluding
    // `viewer`) would need Firebase Auth custom claims. Storage rules can
    // call firestore.get() (used above for isActive()) but there is no path
    // pattern here that maps cleanly to "the role that owns this specific
    // stage transition" the way the Firestore rules do, so that's tracked as
    // a separate follow-up rather than attempted here.
    match /{allPaths=**} {
      allow read: if isActive();
    }

    match /containers/{allPaths=**} {
      allow write: if isActive() && withinSizeAndType() && pathHasOwnUid();
    }
    match /overflow/{allPaths=**} {
      allow write: if isActive() && withinSizeAndType() && pathHasOwnUid();
    }
    match /units/{allPaths=**} {
      allow write: if isActive() && withinSizeAndType() && pathHasOwnUid();
    }
  }
}
